+def aggregate_balanced_panels(records, original):
+    """Each seed contributes once, after an equal mean over its ten balanced IID/non-IID scenes."""
+    import math
+    scenes=[(d,a) for d in ['IID','non-IID'] for a in ['Benign','F Flip','FedSA','S-DFA','Sp-DFA']]
+    by={(r['variant'],r['distribution'],r['attack'],r['seed']):r for r in records}
+    need(len(by)==200 and len(records)==200,'Exact Full100/C100 required')
+    output=[]
+    for view in source.VIEWS:
+        within={}
+        for variant in ['Full','minus_C']:
+            for seed in range(91001,91011):
+                rs=[by[variant,dist,attack,seed] for dist,attack in scenes]
+                need(len(rs)==10,'All ten paired scenes required')
+                within[variant,seed]={m:math.fsum((100*r['views'][view]['accuracy'] if m=='accuracy_pct' else r['views'][view][m]) for r in rs)/10 for m in ['accuracy_pct','aeod','aspd']}
+        for label,seeds in PANELS:
+            rows=[]
+            for variant in ['Full','minus_C','minus_C minus Full']:
+                selected=[]
+                for seed in seeds:
+                    values={m:within['minus_C',seed][m]-within['Full',seed][m] for m in ['accuracy_pct','aeod','aspd']} if variant.endswith(' minus Full') else within[variant,seed]
+                    selected.append(dict(seed=seed,**values))
+                rows.append(dict(distribution='Balanced IID/non-IID',attack='Ten-scene equal mean within seed',variant=variant,**original.statistic(selected,len(seeds))))
+            output.append(dict(view=view,label=label,seeds=seeds,rows=rows))
+    return output
