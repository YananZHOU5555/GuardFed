 p.add_argument('--' + name, type=Path, required=True)\n    a = p.parse_args()\n    assert __debug__ and sys.platform == 'linux'\n    raw = TOOL.read_bytes()\n    assert hashlib.sha256(raw).hexdigest() == TOOL_SHA\n    spec = importlib.util.spec_from_file_location('_original_native_v4_fixed_scope', TOOL)\n    original = importlib.util.module_from_spec(spec)\n    sys.modules[spec.name] = original\n    spec.loader.exec_module(original)\n    before, adapted = derive_backup(raw.decode('utf8'))\n    namespace = dict(original.__dict__, FIXED_IDS=FIXED_IDS)\n    exec(compile(adapted, str(TOOL) + ':FIXED_IDS_METADATA_ONLY', 'exec'), namespace)\n    result = namespace['backup'](a.inspection.resolve(), a.ledger.resolve(), a.archive.resolve())\n    assert result['accepted_new_ids'] == FIXED_IDS\n    result.update(fixed_selected_ids=FIXED_IDS,\n                  original_backup_function_sha256=hashlib.sha256(before.encode()).hexdigest(),\n                  effective_backup_function_sha256=hashlib.sha256(adapted.encode()).hexdigest())\n    print(json.dumps(result))\n\n\nif __name__ == '__main__':\n    main()\n", "--inspection", "/workspace/guardfed_checks/server_reactivation_20261009/native_delta_after380_F_final20_20261011/root_delta_20261011T050221Z/inspection/inspection.json", "--ledger", "/workspace/guardfed_checks/server_reactivation_20261009/native_delta_after380_F_final20_20261011/root_delta_20261011T050221Z/verified_ledger.json", "--archive", "/workspace/guardfed_checks/server_reactivation_20261009/native_delta_after380_F_final20_20261011/root_delta_20261011T050221Z/root_delta_20261011T050221Z.tar.gz"], "returncode": 0, "stdout": "{\"status\": \"VERIFIED_LOCAL_BACKUP\", \"archive\": \"/workspace/guardfed_checks/server_reactivation_20261009/native_delta_after380_F_final20_20261011/root_delta_20261011T050221Z/root_delta_20261011T050221Z.tar.gz\", \"receipt\": \"/workspace/guardfed_checks/server_reactivation_20261009/native_delta_after380_F_final20_20261011/root_delta_20261