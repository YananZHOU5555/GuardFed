+def panel_rows(data,view,n,group=None):
+    panels=data['panels'] if group is None else data[group]
+    hits=[(i,p) for i,p in enumerate(panels) if p['view']==view and len(p['seeds'])==n]
+    require(len(hits)==1,'Unique view/fixed seed panel')
+    i,p=hits[0];seeds=list(range(91001,91011)) if n==10 else list(range(91002,91011)) if n==9 else list(range(91005,91011))
+    require(p['seeds']==seeds,'Exact fixed seed IDs')
+    return i,p,('/panels' if group is None else '/'+group)
+
+def paired_row(data,view,n,group=None):
+    i,p,prefix=panel_rows(data,view,n,group)
+    hits=[(j,r) for j,r in enumerate(p['rows']) if r['variant']=='minus_A minus Full' and (group is not None or (r['distribution'],r['attack'])==('non-IID','Sp-DFA'))]
+    require(len(hits)==1,'Unique actual same-seed paired difference row')
+    j,r=hits[0]
+    require(r['complete'] and r['n']==n and r['seeds']==p['seeds'],'Same paired seed set')
+    return f'{prefix}/{i}/rows/{j}',f'{prefix}/{i}/seeds',r
 
