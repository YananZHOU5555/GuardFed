,H(contract),'\"'\"'--root-binding'\"'\"',str(binding),'\"'\"'--root-binding-sha256'\"'\"',H(binding)]\nr=subprocess.run(cmd,capture_output=True);print(json.dumps({'\"'\"'installed_files'\"'\"':len(pins),'\"'\"'returncode'\"'\"':r.returncode,'\"'\"'binder_stdout'\"'\"':r.stdout.decode(),'\"'\"'binder_stderr'\"'\"':r.stderr.decode(),'\"'\"'contract_sha256'\"'\"':H(contract),'\"'\"'binding_sha256'\"'\"':H(binding)}));sys.exit(r.returncode)\n'"
