+def checked_repo_path(repo, name, expected, mapping):
+    relative = Path(name)
+    if relative.is_absolute() or '..' in relative.parts:
+        raise ValueError('Invalid frozen repository-relative path: ' + name)
+    if name not in mapping:
+        return under(repo, name)
